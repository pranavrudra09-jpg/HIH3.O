# ════════════════════════════════════════════════════════════
# DealBrief AI — Environment Variables
# Copy this file to .env and fill in your credentials.
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# ════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_USERNAME=
APP_PASSWORD=
MAX_REQUEST_BODY_BYTES=65536
GROQ_TIMEOUT_SECONDS=30
HINDSIGHT_TIMEOUT_SECONDS=15

# ── Hindsight by Vectorize ──────────────────────────────────
# Get your API key from: https://hindsight.vectorize.io
# The bank ID is a namespace for your memories — keep as-is or customise.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=dealbrief-ai

# ── Groq LLM ───────────────────────────────────────────────
# Get your API key from: https://console.groq.com
# Recommended model: llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
